# ==============================================================================
# MEDPATH ENVIRONMENT CONFIGURATION (STAGE 2 ROADMAP)
# Copy this file to .env and configure your keys for live services
# ==============================================================================

# Port configuration
PORT=3000

# Google Gemini API (For live AI Healthcare Navigator)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Authentication Provider (Firebase / Supabase / Auth0)
AUTH_PROVIDER=mock
AUTH_CLIENT_ID=
AUTH_DOMAIN=

# FHIR / Electronic Health Records Integration
FHIR_BASE_URL=https://fhir.example.com/r4
FHIR_API_KEY=

# Telehealth & Scheduling Feeds
SCHEDULING_API_URL=https://api.example.com/scheduling
