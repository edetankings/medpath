{
  "name": "medpath",
  "version": "1.0.0",
  "description": "Modern Global Healthcare Navigation Platform",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "build:apk": "powershell -ExecutionPolicy Bypass -File .\\build-apk.ps1",
    "serve": "powershell -ExecutionPolicy Bypass -File .\\serve.ps1",
    "serve:py": "python -B serve.py",
    "backend": "python backend/run.py",
    "test": "python -B -m unittest discover -s tests -p test_static_servers.py -v && node --test tests/vite-security.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "keywords": [
    "healthcare",
    "telehealth",
    "navigation",
    "react",
    "typescript",
    "patient-portal",
    "spa",
    "medical"
  ],
  "author": "MedPath Team",
  "license": "MIT"
}
